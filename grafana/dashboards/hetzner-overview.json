{
  "uid": "hetzner-overview",
  "title": "Hetzner: HTTP and security",
  "description": "The sites behind the Caddy of the Hetzner VPS, and CrowdSec. The vmagent of hetzner-docker sends these metrics.",
  "tags": ["hetzner", "caddy", "crowdsec"],
  "timezone": "browser",
  "editable": true,
  "graphTooltip": 1,
  "schemaVersion": 41,
  "version": 1,
  "time": { "from": "now-24h", "to": "now" },
  "refresh": "1m",
  "templating": {
    "list": [
      {
        "name": "site",
        "label": "Site",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "victoriametrics" },
        "definition": "label_values(caddy_http_requests_total, host)",
        "query": { "query": "label_values(caddy_http_requests_total, host)", "refId": "site" },
        "refresh": 2,
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": { "text": ["All"], "value": ["$__all"] },
        "sort": 1
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Requests/s",
      "datasource": { "type": "prometheus", "uid": "victoriametrics" },
      "gridPos": { "x": 0, "y": 0, "w": 4, "h": 4 },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "decimals": 2,
          "color": { "mode": "fixed", "fixedColor": "blue" }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "auto",
        "justifyMode": "auto",
        "orientation": "auto"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "victoriametrics" },
          "expr": "sum(rate(caddy_http_requests_total{host=~\"$site\"}[$__rate_interval]))"
        }
      ]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "5xx share",
      "description": "The share of the responses with a 5xx code. A 502 on git or photos often means that ronron does not answer.",
      "datasource": { "type": "prometheus", "uid": "victoriametrics" },
      "gridPos": { "x": 4, "y": 0, "w": 4, "h": 4 },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "decimals": 2,
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 0.01 },
              { "color": "red", "value": 0.05 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "auto",
        "justifyMode": "auto",
        "orientation": "auto"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "victoriametrics" },
          "expr": "(sum(rate(caddy_http_request_duration_seconds_count{host=~\"$site\", code=~\"5..\"}[$__rate_interval])) or vector(0)) / sum(rate(caddy_http_request_duration_seconds_count{host=~\"$site\"}[$__rate_interval]))"
        }
      ]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "p95",
      "description": "95 % of the requests take less time than this value, in Caddy and in the app behind it.",
      "datasource": { "type": "prometheus", "uid": "victoriametrics" },
      "gridPos": { "x": 8, "y": 0, "w": 4, "h": 4 },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "decimals": 3,
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 0.5 },
              { "color": "red", "value": 2 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "auto",
        "justifyMode": "auto",
        "orientation": "auto"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "victoriametrics" },
          "expr": "histogram_quantile(0.95, sum by (le) (rate(caddy_http_request_duration_seconds_bucket{host=~\"$site\"}[$__rate_interval])))"
        }
      ]
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Local bans",
      "description": "The IP addresses that CrowdSec bans because of what it saw on this VPS (origin other than CAPI).",
      "datasource": { "type": "prometheus", "uid": "victoriametrics" },
      "gridPos": { "x": 12, "y": 0, "w": 4, "h": 4 },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 0,
          "color": { "mode": "fixed", "fixedColor": "orange" }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "auto",
        "justifyMode": "auto",
        "orientation": "auto"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "victoriametrics" },
          "expr": "sum(cs_active_decisions{action=\"ban\", origin!=\"CAPI\"}) or vector(0)"
        }
      ]
    },
    {
      "id": 5,
      "type": "stat",
      "title": "CAPI bans",
      "description": "The IP addresses of the CrowdSec community blocklist (origin CAPI).",
      "datasource": { "type": "prometheus", "uid": "victoriametrics" },
      "gridPos": { "x": 16, "y": 0, "w": 4, "h": 4 },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 0,
          "color": { "mode": "fixed", "fixedColor": "text" }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "auto",
        "justifyMode": "auto",
        "orientation": "auto"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "victoriametrics" },
          "expr": "sum(cs_active_decisions{action=\"ban\", origin=\"CAPI\"}) or vector(0)"
        }
      ]
    },
    {
      "id": 6,
      "type": "stat",
      "title": "Targets down",
      "description": "The scrape targets of vmagent (vmagent/scrape.yaml of hetzner-docker) that do not answer.",
      "datasource": { "type": "prometheus", "uid": "victoriametrics" },
      "gridPos": { "x": 20, "y": 0, "w": 4, "h": 4 },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 0,
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 1 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "auto",
        "justifyMode": "auto",
        "orientation": "auto"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "victoriametrics" },
          "expr": "count(up == 0) or vector(0)"
        }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Requests per second, by site",
      "datasource": { "type": "prometheus", "uid": "victoriametrics" },
      "gridPos": { "x": 0, "y": 4, "w": 12, "h": 9 },
      "fieldConfig": { "defaults": { "unit": "reqps" }, "overrides": [] },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "victoriametrics" },
          "expr": "sum by (host) (rate(caddy_http_requests_total{host=~\"$site\"}[$__rate_interval]))",
          "legendFormat": "{{host}}"
        }
      ]
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Responses, by status class",
      "datasource": { "type": "prometheus", "uid": "victoriametrics" },
      "gridPos": { "x": 12, "y": 4, "w": 12, "h": 9 },
      "fieldConfig": {
        "defaults": { "unit": "reqps" },
        "overrides": [
          { "matcher": { "id": "byName", "options": "2xx" }, "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "green" } }] },
          { "matcher": { "id": "byName", "options": "3xx" }, "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "blue" } }] },
          { "matcher": { "id": "byName", "options": "4xx" }, "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "orange" } }] },
          { "matcher": { "id": "byName", "options": "5xx" }, "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "red" } }] }
        ]
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "victoriametrics" },
          "expr": "sum(rate(caddy_http_request_duration_seconds_count{host=~\"$site\", code=~\"2..\"}[$__rate_interval]))",
          "legendFormat": "2xx"
        },
        {
          "refId": "B",
          "datasource": { "type": "prometheus", "uid": "victoriametrics" },
          "expr": "sum(rate(caddy_http_request_duration_seconds_count{host=~\"$site\", code=~\"3..\"}[$__rate_interval]))",
          "legendFormat": "3xx"
        },
        {
          "refId": "C",
          "datasource": { "type": "prometheus", "uid": "victoriametrics" },
          "expr": "sum(rate(caddy_http_request_duration_seconds_count{host=~\"$site\", code=~\"4..\"}[$__rate_interval]))",
          "legendFormat": "4xx"
        },
        {
          "refId": "D",
          "datasource": { "type": "prometheus", "uid": "victoriametrics" },
          "expr": "sum(rate(caddy_http_request_duration_seconds_count{host=~\"$site\", code=~\"5..\"}[$__rate_interval]))",
          "legendFormat": "5xx"
        }
      ]
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Errors (4xx and 5xx), by site and code",
      "description": "Many 404 on one site often come from a scan (/wp-login.php, /.env). The host _other is a request for a name that no site has, for example on the IP of the VPS.",
      "datasource": { "type": "prometheus", "uid": "victoriametrics" },
      "gridPos": { "x": 0, "y": 13, "w": 12, "h": 9 },
      "fieldConfig": { "defaults": { "unit": "reqps" }, "overrides": [] },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "victoriametrics" },
          "expr": "sum by (host, code) (rate(caddy_http_request_duration_seconds_count{host=~\"$site\", code=~\"[45]..\"}[$__rate_interval]))",
          "legendFormat": "{{host}} {{code}}"
        }
      ]
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "Duration (p95), by site",
      "datasource": { "type": "prometheus", "uid": "victoriametrics" },
      "gridPos": { "x": 12, "y": 13, "w": 12, "h": 9 },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "victoriametrics" },
          "expr": "histogram_quantile(0.95, sum by (host, le) (rate(caddy_http_request_duration_seconds_bucket{host=~\"$site\"}[$__rate_interval])))",
          "legendFormat": "{{host}}"
        }
      ]
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "CrowdSec: active bans, by origin",
      "datasource": { "type": "prometheus", "uid": "victoriametrics" },
      "gridPos": { "x": 0, "y": 22, "w": 8, "h": 8 },
      "fieldConfig": { "defaults": { "unit": "none", "decimals": 0 }, "overrides": [] },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "victoriametrics" },
          "expr": "sum by (origin) (cs_active_decisions{action=\"ban\"})",
          "legendFormat": "{{origin}}"
        }
      ]
    },
    {
      "id": 12,
      "type": "timeseries",
      "title": "CrowdSec: alerts, by scenario",
      "description": "The number of alerts that the local API of CrowdSec keeps, for each scenario.",
      "datasource": { "type": "prometheus", "uid": "victoriametrics" },
      "gridPos": { "x": 8, "y": 22, "w": 8, "h": 8 },
      "fieldConfig": { "defaults": { "unit": "none", "decimals": 0 }, "overrides": [] },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "victoriametrics" },
          "expr": "sum by (reason) (cs_alerts)",
          "legendFormat": "{{reason}}"
        }
      ]
    },
    {
      "id": 13,
      "type": "timeseries",
      "title": "Data that waits for ronron",
      "description": "The data that vmagent keeps on the disk of the VPS because VictoriaMetrics on ronron does not answer. It goes back to 0 when ronron answers again.",
      "datasource": { "type": "prometheus", "uid": "victoriametrics" },
      "gridPos": { "x": 16, "y": 22, "w": 8, "h": 8 },
      "fieldConfig": { "defaults": { "unit": "bytes" }, "overrides": [] },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "victoriametrics" },
          "expr": "sum by (machine) (vmagent_remotewrite_pending_data_bytes)",
          "legendFormat": "{{machine}}"
        }
      ]
    }
  ]
}
