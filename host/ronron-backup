#!/usr/bin/env bash
# Nightly backup of the stack of ronron (~/ronron-docker) into the local restic
# repository, then a copy of the new snapshots into the offsite restic
# repository, on a Hetzner Storage Box. Installed as
# /usr/local/sbin/ronron-backup, and run as root by ronron-backup.timer
# (host/systemd/).
set -euo pipefail

export RESTIC_REPOSITORY=/srv/backup/restic
export RESTIC_PASSWORD_FILE=/root/.restic-password

# The offsite repository. "storagebox" is a Host of /root/.ssh/config: the
# address and the user of the Storage Box are not in this public repository.
# This repository has its own password. Keep a copy of it outside the house:
# after the loss of ronron, it is the only way to read the offsite copy.
OFFSITE_REPOSITORY=sftp:storagebox:restic
OFFSITE_PASSWORD_FILE=/root/.restic-password-offsite

STACK=/home/tomplanche/ronron-docker
# The Tangled knot: its own Compose project, outside this repository.
TANGLED=/home/tomplanche/tangled
# The push URL of the monitor in Uptime Kuma, without the query: it holds a
# token, so it is in a file of root, not in this public repository.
KUMA_PUSH_URL_FILE=/root/.kuma-push-url

# The same retention in the two repositories: 7 daily, 4 weekly, 6 monthly
# snapshots.
RETENTION=(--keep-daily 7 --keep-weekly 4 --keep-monthly 6)

compose() {
    docker compose -f "$STACK/compose.yaml" "$@"
}

offsite() {
    restic -r "$OFFSITE_REPOSITORY" --password-file "$OFFSITE_PASSWORD_FILE" "$@"
}

# With "nofail", a missing disk leaves an empty mountpoint on the root fs.
mountpoint -q /srv/backup || { echo "backup disk not mounted, aborting" >&2; exit 1; }

# The env files: the secrets of the stack.
restic backup --tag env "$STACK/env"

# Forgejo, Paperless, Grafana and atkuzu: stop them for a consistent snapshot
# of their SQLite database and their files; always start them again, even on
# failure.
backup_stopped() {  # backup_stopped <tag> <services> <paths...>
    local tag=$1 services=$2
    shift 2
    compose stop $services
    # Expand now: $services is local, and it is gone when the trap runs.
    # shellcheck disable=SC2064
    trap "compose start $services" EXIT
    restic backup --tag "$tag" "$@"
    compose start $services
    trap - EXIT
}

# Forgejo: the repositories, the database and the config, and the fonts of the
# theme (not in git).
backup_stopped forgejo forgejo \
  "$STACK/data/forgejo" \
  "$STACK/forgejo/custom/public/assets/fonts"

# Paperless: the database, the documents, the exports and the inbox.
backup_stopped paperless paperless "$STACK/data/paperless"

# Grafana: the users, and the dashboards made in the UI. The metrics of
# VictoriaMetrics are only a history: they are not saved.
backup_stopped grafana grafana "$STACK/data/grafana"

# The apps: the database and the dailies of atkuzu, the static files of
# vps-back (the resumes), and the fonts of the site (not in git).
backup_stopped apps atkuzu \
  "$STACK/data/atkuzu" \
  "$STACK/data/vps-back" \
  "$STACK/data/fonts"

# The Tangled knot: the repositories, the sealed keys, the SSH host key, the
# LFS objects, and knot.env (the master key, which the sealed keys need). Stop
# it like the services above. Skip it while ~/tangled does not exist.
if [ -f "$TANGLED/compose.yaml" ]; then
    docker compose -f "$TANGLED/compose.yaml" stop knot
    trap 'docker compose -f "$TANGLED/compose.yaml" start knot' EXIT
    restic backup --tag knot \
      "$TANGLED/data" \
      "$TANGLED/knot.env" \
      "$TANGLED/config.toml"
    docker compose -f "$TANGLED/compose.yaml" start knot
    trap - EXIT
fi

# Immich: originals + automatic DB dumps (library/backups).
# Live postgres files are inconsistent while running; thumbs and transcodes are regenerable.
restic backup --tag immich \
  --exclude "$STACK/data/immich/library/thumbs" \
  --exclude "$STACK/data/immich/library/encoded-video" \
  "$STACK/data/immich/library"

restic forget --prune "${RETENTION[@]}"

# Verify repository structure and re-read a random 1% of the data.
restic check --read-data-subset=1%

# Offsite: copy the snapshots that the Storage Box does not have yet. The check
# above runs first, so only checked data leaves the house. The first copy
# sends all the repository (several hours); the next ones only the new data.
offsite copy --from-repo "$RESTIC_REPOSITORY" --from-password-file "$RESTIC_PASSWORD_FILE"
offsite forget --prune "${RETENTION[@]}"

# Re-read 500 MiB of the offsite data: 1% is about 1.5 GiB to download each night.
offsite check --read-data-subset=500M

# Heartbeat to Uptime Kuma: only reached if every step above succeeded (set -e),
# the offsite copy included.
if [ -r "$KUMA_PUSH_URL_FILE" ]; then
    curl -fsS -m 10 --retry 3 "$(cat "$KUMA_PUSH_URL_FILE")?status=up&msg=OK" > /dev/null || true
fi
