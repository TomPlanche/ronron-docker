# Env file of atkuzu. Copy to env/atkuzu.env for production. The values below
# are the ones of `just local-up`.
#
# compose.yaml sets HOST, PORT, DATABASE_URL and the proxy headers: they win
# over this file. A value with a `$` must be in single quotes, or Compose
# replaces the variable.

# Required in production: the domain of the atproto OAuth client. Its metadata
# is at https://<OAUTH_DOMAIN>/oauth-client-metadata.json, so the login works
# only on a public HTTPS domain.
OAUTH_DOMAIN=atkuzu.localhost:8080

# The private key set of a confidential OAuth client, as JSON: the output of
# `node bin/gen-jwk.js` in the atkuzu repository. Without it, the client is
# public (no client authentication).
# OAUTH_JWK=

# Optional: the client metadata that the login page of the PDS shows.
# OAUTH_CLIENT_NAME=
# OAUTH_LOGO_URI=
# OAUTH_TOS_URI=
# OAUTH_POLICY_URI=
# OAUTH_SCOPES=
