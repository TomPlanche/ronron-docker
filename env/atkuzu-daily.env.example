# Env file of the atkuzu-daily job. Copy to env/atkuzu-daily.env for
# production. The value below is the one of `just local-up`.

# Required: the master seed of the daily archive. Each puzzle comes from this
# seed, its date and its size, so the seed must stay secret (it gives the
# future puzzles) and must never change.
ATKUZU_DAILY_SEED=local-test-seed
