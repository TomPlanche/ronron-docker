# Env file of immich-server and immich-postgres. Copy to env/immich.env for
# production. The values below are the ones of `just local-up`.
#
# compose.yaml sets the host names, the user (postgres) and the database
# (immich). Do not set UPLOAD_LOCATION or DB_DATA_LOCATION: the data is in
# data/immich/.

# The password of the database user. Use letters and digits only.
DB_PASSWORD=local-test-password

# The same password, for Postgres. It is used only to create a new database.
POSTGRES_PASSWORD=local-test-password
