# Env file of Grafana. Copy to env/grafana.env for production. The values
# below are the ones of `just local-up`. All the settings:
# https://grafana.com/docs/grafana/latest/setup-grafana/configure-grafana/

# The password of the user admin, used at the first start only (an empty
# data/grafana). After that, change it in Grafana.
GF_SECURITY_ADMIN_PASSWORD=local-test-password
