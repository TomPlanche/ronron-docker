# Env file of paperless. Copy to env/paperless.env for production. The values
# below are the ones of `just local-up`. All the settings:
# https://docs.paperless-ngx.com/configuration/

# A long random value. It signs the sessions: keep it when you update.
PAPERLESS_SECRET_KEY=local-test-secret-key

# The URL that opens Paperless. Production: http://10.10.0.4:8000.
PAPERLESS_URL=http://localhost:8010

PAPERLESS_TIME_ZONE=Europe/Paris
PAPERLESS_OCR_LANGUAGE=fra+eng

# The first user (an admin), created at the first start only.
PAPERLESS_ADMIN_USER=admin
PAPERLESS_ADMIN_PASSWORD=local-test-password
