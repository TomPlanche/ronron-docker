# Env file of the hairball job. Copy to env/hairball.env for production. The
# empty values below are the ones of the local test: the GitHub and Last.fm
# sources then fail, and the other sources still run.

# GitHub token, for the contribution calendar (GraphQL API). A fine-grained
# token with "Public repositories" (read-only) and no permission.
GITHUB_TOKEN=

# Last.fm API key, for the scrobbles.
LASTFM_API_KEY=

# Bluesky app password, for the bookmarks. Only with `enabled = true` in
# [bsky_bookmarks] of hairball/config.toml.
# BSKY_APP_PASSWORD=
