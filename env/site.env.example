# Env file of site, also read by next-site before env/next-site.env.
# The values below are the test values of `just local-up`. Production: copy to
# env/site.env, then replace each value with the real one.
#
# compose.yaml sets HOST and PORT: they win over this file.
# The build does not read this file: the image gets the last commit from
# `just build`, not from the GitHub API.

# Maintenance mode: 1, true, yes or on shows only one sentence on every page.
MAINTENANCE=false
# MAINTENANCE_REASON="Working on something"

# GitHub activity feed: a JSON file that vps-cron wrote. Without it, the feed
# stays empty. To use one, mount it in compose.yaml and give its path here.
# GITHUB_ACTIVITY_FILE=/data/github_activity.json
