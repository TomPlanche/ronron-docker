# Env file of contrib-worker. Copy to env/contrib-worker.env for production.
# `just local-up` does not start contrib-worker.

# A Forgejo API token of TARGET_USER, with the scopes read:repository and
# read:user. Make it on ronron, once Forgejo runs:
#   docker compose exec -u git forgejo forgejo admin user generate-access-token \
#     --username tom --token-name contrib-worker --scopes read:repository,read:user
CONTRIB_TOKEN=
