# Env file of vps-back. Copy to env/vps-back.env for production. All the
# values are optional. The values below are the ones of `just local-up`.
#
# compose.yaml sets HOST, PORT and STATIC_DIR: they win over this file.
# A value with a `$` must be in single quotes, or Compose replaces the variable.

# Origins allowed by CORS, separated by commas.
ALLOWED_ORIGINS=http://localhost:8080,http://localhost:3000

RUST_LOG=info

# A GitHub token turns on the periodic update of github-stats.json in the
# static directory. Leave the line out to turn it off: an empty value is not
# the same.
# GITHUB_TOKEN=ghp_xxx
